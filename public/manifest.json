{
  "manifest_version": 3,
  "name": "Chess Tilt Guard",
  "description": "Detect and track chess activity on chess.com and lichess.org",
  "version": "0.1.0",

  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "background": {
    "service_worker": "js/background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*"],
      "js": ["js/content_chess_com.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.lichess.org/*"],
      "js": ["js/content_lichess.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage"],

  "host_permissions": [
    "*://*.chess.com/*",
    "*://*.lichess.org/*"
  ]
}
